---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { iconsType } from '@/types'
import { Icon, SimpleIcon } from '@/components/ui'
import { cn, mediaUrl } from '@/utils'

interface Props {
  class?: string
  projects: {
    slug?: string
    image?: string
    media?: {
      type: 'image' | 'video'
      src: string
      poster?: string
      alt?: string
    }
    title: string
    description: string
    category?: string
    status?: 'active' | 'completed' | 'archived'
    highlights?: string[]
    responsibilities?: string[]
    links: {
      type: string
      href: string
      label?: string
    }[]
  }[]
}

const { class: className, projects, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,webp}'
)

const linkIconSet: Record<string, { type: 'icon' | 'simple', name: string, color?: string }> = {
  github: { type: 'simple', name: 'github', color: '#181717' },
  site: { type: 'icon', name: 'earth' },
  website: { type: 'icon', name: 'earth' },
  demo: { type: 'icon', name: 'play' },
  doc: { type: 'icon', name: 'document' },
  paper: { type: 'icon', name: 'document' },
  arxiv: { type: 'simple', name: 'arxiv', color: '#B31B1B' },
  video: { type: 'simple', name: 'youtube', color: '#FF0000' },
  code: { type: 'icon', name: 'github-circle' },
  release: { type: 'icon', name: 'package' },
  huggingface: { type: 'simple', name: 'huggingface', color: '#FFD21E' },
}

const statusColors = {
  active: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  completed: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  archived: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200'
}
---

<div class={className} data-project-video-section {...props}>
  <div class='grid grid-cols-1 gap-6 lg:grid-cols-2'>
    {
      projects.map((project) => {
        let imagePath = null
        if (project.image) {
          imagePath = '/src/assets/projects/' + project.image
          if (!images[imagePath]) {
            console.warn(`Image not found: ${imagePath}`)
          }
        }

        return (
          <div
            id={project.slug}
            class='group relative overflow-hidden rounded-2xl border border-border bg-card transition-all hover:border-foreground/25 hover:shadow-lg scroll-mt-24'
          >
            {project.media ? (
              <div class='relative overflow-hidden border-b border-border bg-muted/30'>
                {project.media.type === 'video' ? (
                  <video
                    class='h-60 w-full object-cover'
                    controls
                    preload='metadata'
                    playsinline
                    poster={project.media.poster ? mediaUrl(project.media.poster) : undefined}
                  >
                    <source src={mediaUrl(project.media.src)} />
                  </video>
                ) : (
                  <img
                    src={mediaUrl(project.media.src)}
                    alt={project.media.alt || project.title}
                    class='h-60 w-full object-cover'
                    loading='lazy'
                  />
                )}
                {project.status && (
                  <div class='absolute right-3 top-3'>
                    <span class={cn('px-2 py-1 text-xs font-medium rounded-full shadow-sm backdrop-blur', statusColors[project.status])}>
                      {project.status.charAt(0).toUpperCase() + project.status.slice(1)}
                    </span>
                  </div>
                )}
              </div>
            ) : imagePath && images[imagePath] && (
              <div class='relative h-48 overflow-hidden'>
                <Image
                  class='h-full w-full object-cover transition-transform group-hover:scale-105'
                  src={images[imagePath]()}
                  alt={project.title}
                  loading='lazy'
                />
                <div class='absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent' />
                {project.status && (
                  <div class='absolute right-3 top-3'>
                    <span class={cn('px-2 py-1 text-xs font-medium rounded-full', statusColors[project.status])}>
                      {project.status.charAt(0).toUpperCase() + project.status.slice(1)}
                    </span>
                  </div>
                )}
              </div>
            )}
            
            <div class='p-6'>
              <div class='mb-3 flex items-start justify-between'>
                <div class='flex-1'>
                  <p class='text-xl text-foreground group-hover:text-primary transition-colors'>
                    {project.title}
                  </p>
                  {project.category && (
                    <span class='mt-1 inline-block text-sm text-muted-foreground'>
                      {project.category}
                    </span>
                  )}
                </div>
                {!imagePath && project.status && (
                  <span class={cn('px-2 py-1 text-xs font-medium rounded-full', statusColors[project.status])}>
                    {project.status.charAt(0).toUpperCase() + project.status.slice(1)}
                  </span>
                )}
              </div>
              
              <p class='mb-4 text-muted-foreground leading-relaxed'>
                {project.description}
              </p>

              {project.highlights && project.highlights.length > 0 && (
                <div class='mb-4'>
                  <p class='mb-2 text-xs font-semibold uppercase tracking-wide text-primary'>出彩点</p>
                  <ul class='space-y-1.5'>
                    {project.highlights.map((highlight) => (
                      <li class='text-sm leading-relaxed text-foreground/85'>
                        {highlight}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {project.responsibilities && project.responsibilities.length > 0 && (
                <div class='mb-5'>
                  <p class='mb-2 text-xs font-semibold uppercase tracking-wide text-primary'>我的职责</p>
                  <div class='flex flex-wrap gap-2'>
                    {project.responsibilities.map((item) => (
                      <span class='rounded-full border border-border bg-muted/60 px-3 py-1 text-xs font-medium text-foreground/80'>
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              
              <div class='flex flex-wrap gap-2'>
                {project.links.map((link) => {
                  const iconConfig = linkIconSet[link.type] || { type: 'icon', name: 'earth' }
                  const resolvedHref = mediaUrl(link.href)
                  const isVideoLink = link.type === 'video'
                  return (
                    isVideoLink ? (
                      <button
                        type='button'
                        class='inline-flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/80 hover:text-foreground'
                        aria-label={link.label || link.type}
                        data-project-video-trigger
                        data-video-src={resolvedHref}
                        data-video-title={`${project.title} · ${link.label || link.type.charAt(0).toUpperCase() + link.type.slice(1)}`}
                      >
                        {iconConfig.type === 'simple' ? (
                          <SimpleIcon
                            class='size-4'
                            name={iconConfig.name}
                            color={iconConfig.color}
                          />
                        ) : (
                          <Icon class='size-4' name={iconConfig.name as iconsType} />
                        )}
                        {link.label || link.type.charAt(0).toUpperCase() + link.type.slice(1)}
                      </button>
                    ) : (
                      <a
                        href={resolvedHref}
                        class='inline-flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/80 hover:text-foreground'
                        aria-label={link.label || link.type}
                        target='_blank'
                        rel='noopener noreferrer'
                      >
                        {iconConfig.type === 'simple' ? (
                          <SimpleIcon
                            class='size-4'
                            name={iconConfig.name}
                            color={iconConfig.color}
                          />
                        ) : (
                          <Icon class='size-4' name={iconConfig.name as iconsType} />
                        )}
                        {link.label || link.type.charAt(0).toUpperCase() + link.type.slice(1)}
                      </a>
                    )
                  )
                })}
              </div>
            </div>
          </div>
        )
      })
    }
  </div>

  <dialog
    data-project-video-modal
    class='m-auto w-[min(960px,calc(100vw-2rem))] rounded-2xl border border-border bg-card p-0 text-foreground shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm'
  >
    <div data-project-video-panel class='flex flex-col'>
      <div class='flex items-center justify-between border-b border-border px-4 py-3'>
        <p data-project-video-title class='pr-4 text-sm font-semibold text-foreground'></p>
        <button
          type='button'
          data-project-video-close
          class='rounded-lg border border-border bg-muted/70 px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground'
        >
          关闭
        </button>
      </div>
      <div class='bg-black'>
        <video
          data-project-video-player
          class='max-h-[75vh] w-full bg-black'
          controls
          preload='metadata'
          playsinline
        ></video>
      </div>
    </div>
  </dialog>
</div>

<script>
  const sections = document.querySelectorAll('[data-project-video-section]')

  sections.forEach((section) => {
    const modal = section.querySelector('[data-project-video-modal]')
    const player = section.querySelector('[data-project-video-player]')
    const title = section.querySelector('[data-project-video-title]')
    const closeButton = section.querySelector('[data-project-video-close]')
    const triggers = section.querySelectorAll('[data-project-video-trigger]')

    if (
      !(modal instanceof HTMLDialogElement) ||
      !(player instanceof HTMLVideoElement) ||
      !(title instanceof HTMLElement) ||
      !(closeButton instanceof HTMLButtonElement)
    ) {
      return
    }

    const resetPlayer = () => {
      player.pause()
      player.removeAttribute('src')
      player.load()
    }

    const closeModal = () => {
      resetPlayer()
      modal.close()
    }

    triggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLButtonElement)) return

      trigger.addEventListener('click', () => {
        const src = trigger.dataset.videoSrc
        const videoTitle = trigger.dataset.videoTitle || '项目视频'

        if (!src) return

        title.textContent = videoTitle
        player.src = src
        player.load()
        modal.showModal()
      })
    })

    closeButton.addEventListener('click', closeModal)
    modal.addEventListener('close', resetPlayer)
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal()
      }
    })
  })
</script>
