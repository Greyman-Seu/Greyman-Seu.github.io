---
import type { CollectionEntry } from 'astro:content'
import { getPostsForCollection } from '@/utils/server'
import { cn } from '@/utils'

interface Props {
  collection: CollectionEntry<'postCollections'>
  currentId: string
  isEn?: boolean
}

const { collection, currentId, isEn = false } = Astro.props
const posts = await getPostsForCollection(collection, isEn)
const title = isEn && collection.data.title_en ? collection.data.title_en : collection.data.title
const collectionUrl = isEn ? `/en/collection/${collection.id}` : `/collection/${collection.id}`
---

<nav class='series-nav mb-6'>
  <h2 class='font-semibold'>
    <a href={collectionUrl} class='hover:text-primary transition-colors' title={title}>
      IN THIS SERIES
    </a>
  </h2>

  <ol class='mt-4 flex flex-col gap-0.5 border-l border-border pl-3 overflow-y-auto' style='max-height: calc(10 * 2rem)'>
    {posts.map((post, index) => {
      const isCurrent = post.id === currentId
      const postUrl = isEn ? `/en/blog/${post.id}` : `/blog/${post.id}`
      return (
        <li>
          <a
            href={postUrl}
            class={cn(
              'flex items-start gap-2 rounded py-1 text-xs leading-snug transition-colors hover:text-primary',
              isCurrent ? 'font-semibold text-primary' : 'text-muted-foreground'
            )}
            aria-current={isCurrent ? 'page' : undefined}
          >
            <span class='mt-0.5 shrink-0 tabular-nums text-muted-foreground/60'>{index + 1}.</span>
            <span class='line-clamp-2'>{post.data.title}</span>
          </a>
        </li>
      )
    })}
  </ol>
</nav>
