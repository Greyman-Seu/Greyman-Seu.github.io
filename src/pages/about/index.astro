---
import PageLayout from '@/layouts/CommonPage.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import { Comment } from '@/components/widgets'
import { Button } from '@/components/ui'
import { Spoiler } from '@/components/mdx'

const headings = [
  { depth: 2, slug: 'summary', text: '个人简介' },
  { depth: 2, slug: 'education', text: '教育背景' },
  { depth: 2, slug: 'experience', text: '工作经历' },
  { depth: 2, slug: 'skills', text: '技术技能' },
  { depth: 2, slug: 'projects', text: '项目经历' },
  { depth: 2, slug: 'tools', text: '工具' }
]
---

<PageLayout title='Resume' {headings} info='/about'>

  {/* ── 个人简介 ── */}
  <h2 id='summary'>个人简介<a class='anchor' href='#summary'>#</a></h2>
  <p>
    <!-- 示例：一两句话介绍你的身份和主要方向 -->
    热爱技术的 <Spoiler>产品经理 / 工程师 / 研究者</Spoiler>，专注于 [你的核心领域]。
    拥有 [X] 年行业经验，擅长 [核心能力1] 和 [核心能力2]，致力于用技术解决实际问题。
  </p>
  <p>
    <!-- 可以加一行兴趣/个性描述，让简历更有温度 -->
    业余时间喜欢写作、折腾开源项目，以及 [你的兴趣爱好]。
  </p>
  <Button title='联系我' class='w-fit' href='mailto:your@email.com' style='ahead' />

  {/* ── 教育背景 ── */}
  <h2 id='education'>教育背景<a class='anchor' href='#education'>#</a></h2>

  <p><strong>XX 大学</strong> · 计算机科学与技术 · 硕士</p>
  <p class='text-muted-foreground text-sm'>2021.09 — 2024.06</p>
  <ul>
    <li>研究方向：[方向，如机器学习 / 分布式系统 / 计算机视觉]</li>
    <li>GPA：3.8 / 4.0（专业前 10%）</li>
    <li>主要课程：算法设计、深度学习、数据库系统</li>
  </ul>

  <p><strong>YY 大学</strong> · 软件工程 · 学士</p>
  <p class='text-muted-foreground text-sm'>2017.09 — 2021.06</p>
  <ul>
    <li>优秀毕业生，毕业论文评级：优秀</li>
    <li>校级奖学金 2 次</li>
  </ul>

  {/* ── 工作经历 ── */}
  <h2 id='experience'>工作经历<a class='anchor' href='#experience'>#</a></h2>

  <p><strong>公司 A</strong> · 高级工程师 / 产品经理</p>
  <p class='text-muted-foreground text-sm'>2024.07 — 至今 · [城市]</p>
  <ul>
    <li>负责 [核心模块/产品] 的设计与研发，DAU 提升 XX%</li>
    <li>主导 [重要项目] 落地，涉及 [技术栈]，上线后性能提升 XX%</li>
    <li>跨部门协作，推动 [某事项] 从 0 到 1 完成</li>
  </ul>

  <p><strong>公司 B</strong> · 工程师 / 实习生</p>
  <p class='text-muted-foreground text-sm'>2023.06 — 2024.06 · [城市]</p>
  <ul>
    <li>参与 [项目名] 开发，使用 [技术栈] 实现 [功能]</li>
    <li>优化 [模块] 性能，响应时间从 Xms 降至 Yms</li>
  </ul>

  {/* ── 技术技能 ── */}
  <h2 id='skills'>技术技能<a class='anchor' href='#skills'>#</a></h2>
  <ul>
    <li><strong>编程语言：</strong>Python · TypeScript · Go · Java（按熟练度排序）</li>
    <li><strong>前端：</strong>React · Astro · Tailwind CSS · Next.js</li>
    <li><strong>后端 / 数据：</strong>FastAPI · Node.js · PostgreSQL · Redis · MongoDB</li>
    <li><strong>AI / ML：</strong>PyTorch · Transformers · LangChain · OpenCV</li>
    <li><strong>DevOps：</strong>Docker · GitHub Actions · Linux · Nginx</li>
    <li><strong>语言：</strong>中文（母语）· 英文（CET-6 / 雅思 X 分）</li>
  </ul>

  {/* ── 项目经历 ── */}
  <h2 id='projects'>项目经历<a class='anchor' href='#projects'>#</a></h2>

  <p><strong>项目 A</strong> · <a href='https://github.com/'>GitHub ↗</a></p>
  <p class='text-muted-foreground text-sm'>2024.01 — 2024.06 · 个人项目 / 团队项目</p>
  <ul>
    <li>简述项目背景：解决了什么问题，面向什么用户</li>
    <li>技术栈：[前端框架] + [后端] + [数据库]</li>
    <li>结果：GitHub Stars XX，月活 XX 人，或发表于 [期刊/会议]</li>
  </ul>

  <p><strong>项目 B</strong></p>
  <p class='text-muted-foreground text-sm'>2023.09 — 2023.12</p>
  <ul>
    <li>项目描述</li>
    <li>你的贡献与亮点</li>
  </ul>

  {/* ── 工具 ── */}
  <h2 id='tools'>工具<a class='anchor' href='#tools'>#</a></h2>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'VS Code',
        description: 'Code Editor',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Cursor',
        description: 'AI-powered Code Editor',
        href: 'https://cursor.com',
        icon: import('@/assets/tools/cursor.svg?raw')
      },
      {
        name: 'Chrome',
        description: 'Web Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Ubuntu',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      }
    ]}
  />

  <Comment slot='bottom' />
</PageLayout>
