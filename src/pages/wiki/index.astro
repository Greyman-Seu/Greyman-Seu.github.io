---
import CommonPage from '@/layouts/CommonPage.astro'
import { Button, Label } from '@/components/ui'
import {
  allWikiSources as localWikiSources,
  allWikiSyntheses as localWikiSyntheses,
  allWikiTopics as localWikiTopics,
  getWikiHref,
  wikiDomains
} from '@/data/wiki'
import type { WikiSource, WikiSynthesis, WikiTopic } from '@/data/wiki'
import { ENABLE_REMOTE_WIKI_DATA, REQUIRE_REMOTE_WIKI_DATA, WIKI_DATA_BASE_URL } from '@/data/generated/wiki-client'

const fetchRemoteJson = async <T,>(path: string): Promise<T | null> => {
  if (!ENABLE_REMOTE_WIKI_DATA) return null
  try {
    const response = await fetch(`${WIKI_DATA_BASE_URL.replace(/\/+$/, '')}/${path.replace(/^\/+/, '')}`, { cache: 'no-store' })
    if (!response.ok) {
      if (REQUIRE_REMOTE_WIKI_DATA) throw new Error(`HTTP ${response.status} for ${path}`)
      return null
    }
    return (await response.json()) as T
  } catch (error) {
    if (REQUIRE_REMOTE_WIKI_DATA) throw error
    return null
  }
}

const remoteSources = await fetchRemoteJson<WikiSource[]>('sources.json')
const remoteTopics = await fetchRemoteJson<WikiTopic[]>('topics.json')
const remoteSyntheses = await fetchRemoteJson<WikiSynthesis[]>('synthesis.json')
const allWikiSources = Array.isArray(remoteSources) && remoteSources.length ? remoteSources : localWikiSources
const allWikiTopics = Array.isArray(remoteTopics) && remoteTopics.length ? remoteTopics : localWikiTopics
const allWikiSyntheses = Array.isArray(remoteSyntheses) && remoteSyntheses.length ? remoteSyntheses : localWikiSyntheses

const headings = [
  { depth: 2, slug: 'scope', text: '覆盖范围' },
  { depth: 2, slug: 'recent-additions', text: '最近更新' },
]

const recentItems = [
  ...allWikiTopics.map((topic) => ({
    type: 'topic' as const,
    slug: topic.slug,
    title: topic.title,
    date: topic.updatedDate,
    summary: topic.summary
  })),
  ...allWikiSources.map((source) => ({
    type: 'source' as const,
    slug: source.slug,
    title: source.title,
    date: source.publishDate,
    summary: source.summary
  })),
  ...allWikiSyntheses.map((entry) => ({
    type: 'synthesis' as const,
    slug: entry.slug,
    title: entry.title,
    date: entry.updatedDate,
    summary: entry.summary
  }))
]
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 5)
const latestSynthesis = allWikiSyntheses
  .slice()
  .sort((a, b) => +new Date(b.updatedDate) - +new Date(a.updatedDate))[0]

const entryCards = [
  {
    title: '材料库',
    value: `${allWikiSources.length} 条`,
    href: '/wiki/papers'
  },
  {
    title: '主题路线',
    value: `${allWikiTopics.length} 个`,
    href: '/wiki/topics'
  },
  {
    title: '综述判断',
    value: `${allWikiSyntheses.length} 篇`,
    href: '/wiki/syntheses'
  },
  {
    title: '图谱导航',
    value: '关系视图',
    href: '/wiki/graph'
  }
]

const typeLabels: Record<string, string> = {
  source: '材料',
  topic: '主题',
  synthesis: '综述判断'
}
---

<CommonPage title='知识库' {headings} info='/wiki'>
  <div class='space-y-8'>
    <section class='overflow-hidden rounded-2xl border border-primary/15 bg-[linear-gradient(135deg,rgba(255,250,242,0.98),rgba(246,248,247,0.98)_48%,rgba(229,242,239,0.92))] p-6 shadow-[0_22px_64px_rgba(34,40,42,0.08)]'>
      <div class='max-w-5xl space-y-5'>
        <Label title='知识地图' />
        <div class='grid grid-cols-2 gap-2 lg:grid-cols-4'>
          {entryCards.map((card) => (
            <a class='rounded-2xl border border-border/70 bg-background/75 p-3 text-center no-underline transition-all hover:border-primary/40 hover:bg-card hover:shadow-sm' href={card.href}>
              <span class='block text-[11px] text-muted-foreground'>{card.title}</span>
              <strong class='mt-1 block text-xl font-semibold text-foreground'>{card.value}</strong>
            </a>
          ))}
        </div>
        <section class='rounded-2xl border border-border/70 bg-background/65 p-4' aria-labelledby='scope'>
          <div class='flex flex-col gap-3 sm:flex-row sm:items-center'>
            <h3 id='scope' class='m-0 shrink-0 text-sm font-semibold text-muted-foreground'>覆盖范围</h3>
            <div class='flex flex-wrap gap-2'>
              {wikiDomains.map((domain) => (
                <a class='rounded-full border border-border/70 bg-card/70 px-3 py-1.5 text-sm font-medium text-muted-foreground no-underline hover:border-primary/35 hover:bg-card hover:text-foreground' href={`/wiki/domain/${domain.slug}`}>
                  {domain.name}
                </a>
              ))}
            </div>
          </div>
        </section>
      </div>
    </section>

    {latestSynthesis ? (
      <section class='rounded-2xl border border-border bg-card p-5'>
        <div class='grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center'>
          <div>
            <p class='m-0 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground/80'>推荐综述判断</p>
            <h2 class='m-0 mt-2 text-2xl font-semibold text-foreground'>{latestSynthesis.title}</h2>
            <p class='m-0 mt-2 text-sm leading-7 text-muted-foreground'>{latestSynthesis.summary}</p>
          </div>
          <Button title='打开综述' href={`/wiki/synthesis/${latestSynthesis.slug}`} style='ahead' />
        </div>
      </section>
    ) : null}

    <section class='space-y-4' aria-labelledby='recent-additions'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='recent-additions' class='m-0 text-2xl font-semibold'>最近更新</h2>
        <p class='m-0 mt-1 text-sm text-muted-foreground'>按更新时间混排展示，标签只说明阅读类型，不暴露内部数据模型。</p>
      </div>

      <div class='space-y-3'>
        {recentItems.map((item) => (
          <article class='rounded-2xl border border-border bg-card p-4 transition-all hover:border-foreground/20 hover:shadow-sm'>
            <div class='grid gap-3 sm:grid-cols-[92px_minmax(0,1fr)_auto] sm:items-center'>
              <div class='flex items-center gap-2 sm:block'>
                <span class='rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary'>{typeLabels[item.type]}</span>
                <span class='text-xs text-muted-foreground sm:mt-2 sm:block'>{item.date}</span>
              </div>
              <div class='min-w-0'>
                <h3 class='m-0 text-base font-semibold text-foreground'>{item.title}</h3>
                <p class='m-0 mt-1 line-clamp-2 text-sm leading-6 text-muted-foreground'>{item.summary}</p>
              </div>
              <Button title='打开' href={getWikiHref(item)} style='ahead' />
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</CommonPage>
