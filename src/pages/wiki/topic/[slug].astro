---
import CommonPage from '@/layouts/CommonPage.astro'
import { Button } from '@/components/ui'
import { allWikiTopics, getWikiSourceBySlug, getWikiSynthesisBySlug, getWikiTopicBySlug } from '@/data/wiki'
import { renderWikiSection } from '@/data/generated/wiki-render'

export const prerender = true

export const getStaticPaths = async () =>
  allWikiTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic }
  }))

const { topic } = Astro.props as { topic: (typeof allWikiTopics)[number] }
const current = getWikiTopicBySlug(Astro.params.slug || topic.slug) || topic
const render = (value?: string) => ({ __html: renderWikiSection(String(value || '')) })

const relatedSources = current.relatedSourceSlugs
  .map((slug) => getWikiSourceBySlug(slug))
  .filter((source): source is NonNullable<typeof source> => Boolean(source))

const relatedSyntheses = (current.relatedSynthesisSlugs || [])
  .map((slug) => getWikiSynthesisBySlug(slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))

const hasKeyQuestions = Boolean(current.keyQuestions?.length)
const headings = [
  { depth: 2, slug: 'body', text: '正文' },
  ...(hasKeyQuestions ? [{ depth: 2, slug: 'questions', text: '关键问题' }] : []),
  { depth: 2, slug: 'papers', text: '相关材料' },
  ...(relatedSyntheses.length ? [{ depth: 2, slug: 'synthesis', text: '相关综述' }] : [])
]
---

<CommonPage title={current.title} {headings} info={`/wiki/topic/${current.slug}`}>
  <div class='space-y-6'>
    <section class='rounded-2xl border border-border bg-card p-4 shadow-sm sm:p-5'>
      <div class='flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between'>
        <div class='flex flex-wrap gap-2 text-sm'>
          <span class='rounded-full border border-border/70 bg-background px-3 py-1.5 text-muted-foreground'>材料 {relatedSources.length}</span>
          <span class='rounded-full border border-border/70 bg-background px-3 py-1.5 text-muted-foreground'>综述 {relatedSyntheses.length}</span>
          <span class='rounded-full border border-border/70 bg-background px-3 py-1.5 text-muted-foreground'>更新 {current.updatedDate || '未知'}</span>
        </div>
        <nav class='flex flex-wrap gap-2' aria-label='主题详情导航'>
          <Button title='返回主题' href='/wiki/topics' style='back' />
          <Button title='浏览材料' href='/wiki/papers' />
          <Button title='综述判断' href='/wiki/syntheses' style='ahead' />
        </nav>
      </div>
      <p class='m-0 mt-4 max-w-4xl border-t border-border/40 pt-4 text-sm leading-7 text-muted-foreground'>{current.summary}</p>
    </section>

    <section class='space-y-6'>
      <article class='space-y-6'>
        <section class='space-y-3' aria-labelledby='body'>
          <div class='border-b border-border/40 pb-3'>
            <h2 id='body' class='m-0 text-2xl font-semibold'>正文</h2>
          </div>
          <div class='rounded-2xl border border-border bg-card p-5'>
            <div class='wiki-rich text-sm leading-7 text-muted-foreground' set:html={render(current.body || current.definition || current.whyItMatters).__html} />
          </div>
        </section>

        {hasKeyQuestions ? (
          <section class='space-y-3' aria-labelledby='questions'>
            <div class='border-b border-border/40 pb-3'>
              <h2 id='questions' class='m-0 text-2xl font-semibold'>关键问题</h2>
            </div>
            <div class='rounded-2xl border border-border bg-card p-5'>
              <ul class='space-y-3 pl-5 text-sm leading-7 text-muted-foreground'>
                {(current.keyQuestions || []).map((question) => (
                  <li>{question}</li>
                ))}
              </ul>
            </div>
          </section>
        ) : null}
      </article>
    </section>

    <section class='space-y-3' aria-labelledby='papers'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='papers' class='m-0 text-2xl font-semibold'>相关材料</h2>
      </div>
      <div class='space-y-3'>
        {relatedSources.map((source) => (
          <article class='rounded-2xl border border-border bg-card p-5'>
            <div class='space-y-4'>
              <div>
                <h3 class='m-0 text-lg font-semibold text-foreground'>{source.title}</h3>
                <p class='m-0 mt-2 text-sm leading-6 text-muted-foreground'>{source.tldr || source.summary}</p>
              </div>
              <div class='flex flex-wrap gap-2 border-t border-border/40 pt-3'>
                <Button title='阅读材料' href={`/wiki/source/${source.slug}`} style='ahead' />
                {source.sourceUrl && <Button title='原文' href={source.sourceUrl} target='_blank' rel='noreferrer' />}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {relatedSyntheses.length ? (
      <section class='space-y-3' aria-labelledby='synthesis'>
        <div class='border-b border-border/40 pb-3'>
          <h2 id='synthesis' class='m-0 text-2xl font-semibold'>相关综述</h2>
        </div>
        <div class='space-y-3'>
          {relatedSyntheses.map((entry) => (
            <article class='rounded-2xl border border-border bg-card p-5'>
              <div class='space-y-4'>
                <div>
                  <h3 class='m-0 text-lg font-semibold text-foreground'>{entry.title}</h3>
                  <p class='m-0 mt-2 text-sm leading-6 text-muted-foreground'>{entry.summary}</p>
                </div>
                <div class='flex flex-wrap gap-2 border-t border-border/40 pt-3'>
                  <Button title='打开综述' href={`/wiki/synthesis/${entry.slug}`} style='ahead' />
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null}
  </div>
</CommonPage>
