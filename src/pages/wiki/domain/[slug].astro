---
import CommonPage from '@/layouts/CommonPage.astro'
import { Button, Label } from '@/components/ui'
import { getSourcesByDomain, getSynthesesByDomain, getTopicsByDomain, getWikiDomainBySlug, wikiDomains } from '@/data/wiki'
import type { WikiDomain } from '@/data/wiki'

export const prerender = true

export const getStaticPaths = async () =>
  wikiDomains.map((domain: WikiDomain) => ({
    params: { slug: domain.slug },
    props: { domain }
  }))

const domainSlug = Astro.params.slug || (Astro.props as { domain?: WikiDomain }).domain?.slug || ''
const { domain } = Astro.props as { domain: WikiDomain }

const headings = [
  { depth: 2, slug: 'definition', text: 'Definition' },
  { depth: 2, slug: 'key-questions', text: 'Key Questions' },
  { depth: 2, slug: 'focus-areas', text: 'Focus Areas' },
  { depth: 2, slug: 'topics', text: 'Topics' },
  { depth: 2, slug: 'sources', text: 'Sources' },
  { depth: 2, slug: 'synthesis', text: 'Synthesis' },
  { depth: 2, slug: 'recent-signals', text: 'Recent Signals' }
]

const current = getWikiDomainBySlug(domainSlug) || getWikiDomainBySlug(domain.slug) || domain
const topics = getTopicsByDomain(current.slug)
const sources = getSourcesByDomain(current.slug)
const syntheses = getSynthesesByDomain(current.slug)
---

<CommonPage title={current.name} {headings} info={`/wiki/domain/${current.slug}`}>
  <div class='space-y-8'>
    <section class='rounded-2xl border border-primary/15 bg-gradient-to-br from-primary/10 via-background to-background p-6'>
      <div class='flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between'>
        <div class='space-y-2'>
          <Label title='Domain Page' />
          <h2 class='m-0 text-2xl font-semibold text-foreground sm:text-3xl'>{current.name}</h2>
          <p class='max-w-3xl text-sm leading-6 text-muted-foreground'>{current.summary}</p>
        </div>
        <div class='flex flex-wrap gap-2'>
          <Button title='Back to Wiki' href='/wiki' style='back' />
          <Button title='Open Graph' href='/wiki/graph' style='ahead' />
        </div>
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='definition'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='definition' class='m-0 text-2xl font-semibold'>Definition</h2>
      </div>
      <div class='rounded-2xl border border-border bg-card p-5'>
        <p class='m-0 text-sm leading-7 text-muted-foreground'>{current.definition}</p>
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='key-questions'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='key-questions' class='m-0 text-2xl font-semibold'>Key Questions</h2>
      </div>
      <div class='rounded-2xl border border-border bg-card p-5'>
        <ul class='space-y-3 pl-5 text-sm leading-7 text-muted-foreground'>
          {current.keyQuestions.map((question: string) => (
            <li>{question}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='focus-areas'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='focus-areas' class='m-0 text-2xl font-semibold'>Focus Areas</h2>
      </div>
      <div class='rounded-2xl border border-border bg-card p-5'>
        <ul class='space-y-3 pl-5 text-sm leading-7 text-muted-foreground'>
          {current.focusAreas.map((area: string) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='topics'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='topics' class='m-0 text-2xl font-semibold'>Topics</h2>
      </div>
      <div class='grid grid-cols-1 gap-3 lg:grid-cols-2'>
        {topics.map((topic) => (
          <article class='rounded-2xl border border-border bg-card p-5'>
            <div class='space-y-3'>
              <div>
                <h3 class='m-0 text-lg font-semibold text-foreground'>{topic.title}</h3>
                <p class='m-0 mt-2 text-sm leading-6 text-muted-foreground'>{topic.summary}</p>
              </div>
              <div class='flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
                <span>Updated {topic.updatedDate}</span>
              </div>
              <div class='flex flex-wrap gap-2'>
                <Button title='Open Topic' href={`/wiki/topic/${topic.slug}`} style='ahead' />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='sources'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='sources' class='m-0 text-2xl font-semibold'>Sources</h2>
      </div>
      <div class='space-y-3'>
        {sources.map((source) => (
          <article class='rounded-2xl border border-border bg-card p-5'>
            <div class='space-y-3'>
              <div class='flex flex-wrap items-center gap-2'>
                <span class='rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium uppercase tracking-[0.14em] text-primary'>{source.sourceType}</span>
                <span class='text-xs text-muted-foreground'>{source.publishDate}</span>
              </div>
              <div>
                <h3 class='m-0 text-lg font-semibold text-foreground'>{source.title}</h3>
                <p class='m-0 mt-2 text-sm leading-6 text-muted-foreground'>{source.summary}</p>
              </div>
              <div class='flex flex-wrap gap-2'>
                <Button title='Open Source' href={`/wiki/source/${source.slug}`} style='ahead' />
                {source.sourceUrl && <Button title='Original Link' href={source.sourceUrl} target='_blank' rel='noreferrer' />}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='synthesis'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='synthesis' class='m-0 text-2xl font-semibold'>Synthesis</h2>
      </div>
      <div class='space-y-3'>
        {syntheses.map((entry) => (
          <article class='rounded-2xl border border-border bg-card p-5'>
            <div class='space-y-3'>
              <div class='flex flex-wrap items-center gap-2'>
                <span class='rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium uppercase tracking-[0.14em] text-primary'>{entry.kind}</span>
                <span class='text-xs text-muted-foreground'>Updated {entry.updatedDate}</span>
              </div>
              <div>
                <h3 class='m-0 text-lg font-semibold text-foreground'>{entry.title}</h3>
                <p class='m-0 mt-2 text-sm leading-6 text-muted-foreground'>{entry.summary}</p>
              </div>
              <div class='flex flex-wrap gap-2'>
                <Button title='Open Synthesis' href={`/wiki/synthesis/${entry.slug}`} style='ahead' />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class='space-y-3' aria-labelledby='recent-signals'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='recent-signals' class='m-0 text-2xl font-semibold'>Recent Signals</h2>
      </div>
      <div class='rounded-2xl border border-border bg-card p-5'>
        <ul class='space-y-3 pl-5 text-sm leading-7 text-muted-foreground'>
          {current.recentSignals.map((signal: string) => (
            <li>{signal}</li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</CommonPage>
