---
import CommonPage from '@/layouts/CommonPage.astro'
import { Button } from '@/components/ui'
import { allWikiSources, allWikiSyntheses, allWikiTopics, wikiGraphData } from '@/data/wiki'

const headings = [
  { depth: 2, slug: 'graph', text: '知识图谱' }
]

const sourceCount = allWikiSources.length
const topicCount = allWikiTopics.length
const synthesisCount = allWikiSyntheses.length
const updatedDate = wikiGraphData.meta?.build_date
  ? new Date(wikiGraphData.meta.build_date).toISOString().slice(0, 10)
  : ''
const graphDataHref = '/wiki/graph/data.json'
const graphAppHref = `/wiki-graph/knowledge-graph.html?embed=1&data=${encodeURIComponent(graphDataHref)}`
---

<CommonPage title='知识图谱' {headings} info='/wiki/graph'>
  <div class='wiki-graph-host space-y-4'>
    <section class='graph-toolbar' aria-labelledby='graph'>
      <div class='graph-title'>
        <h2 id='graph' class='m-0 text-2xl font-semibold text-foreground'>知识图谱</h2>
        <div class='graph-stats' aria-label='图谱状态'>
          <span>材料 {sourceCount}</span>
          <span>主题 {topicCount}</span>
          <span>综述 {synthesisCount}</span>
          {updatedDate ? <span>更新 {updatedDate}</span> : null}
        </div>
      </div>
      <div class='graph-actions'>
        <Button title='返回知识库' href='/wiki' style='back' />
        <Button title='材料' href='/wiki/papers' />
        <Button title='主题' href='/wiki/topics' />
        <Button title='综述' href='/wiki/syntheses' style='ahead' />
      </div>
    </section>

    <section class='graph-frame-shell' aria-label='知识图谱'>
      <iframe src={graphAppHref} title='知识图谱' loading='eager'></iframe>
    </section>
  </div>
</CommonPage>

<style is:global>
  body:has(.wiki-graph-host) #sidebar {
    display: none;
  }

  body:has(.wiki-graph-host) main {
    display: block;
  }

  body:has(.wiki-graph-host) main > article {
    width: 100%;
  }

  .wiki-graph-host {
    width: calc(100vw - 32px);
    max-width: 1680px;
    margin-left: calc(50% - 50vw + 16px);
    padding-bottom: 24px;
  }

  .wiki-graph-host .graph-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid hsl(var(--border));
    border-radius: 16px;
    background: hsl(var(--card) / 0.9);
    padding: 14px 16px;
    box-shadow: 0 18px 52px rgba(34, 40, 42, 0.08);
  }

  .wiki-graph-host .graph-title {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .wiki-graph-host .graph-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wiki-graph-host .graph-stats span {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--background) / 0.72);
    padding: 0 10px;
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .wiki-graph-host .graph-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .wiki-graph-host .graph-frame-shell {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 18px;
    background: hsl(var(--card));
    box-shadow: 0 24px 70px rgba(34, 40, 42, 0.1);
  }

  .wiki-graph-host iframe {
    display: block;
    width: 100%;
    height: min(900px, calc(100vh - 148px));
    min-height: 740px;
    border: 0;
    background: transparent;
  }

  @media (min-width: 1712px) {
    .wiki-graph-host {
      margin-left: calc(50% - 840px);
    }
  }

  @media (max-width: 1180px) {
    .wiki-graph-host {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 760px) {
    .wiki-graph-host .graph-toolbar,
    .wiki-graph-host .graph-title {
      align-items: flex-start;
      flex-direction: column;
    }

    .wiki-graph-host .graph-actions {
      justify-content: flex-start;
    }

    .wiki-graph-host iframe {
      height: calc(100vh - 148px);
      min-height: 660px;
    }
  }
</style>
