---
import { render, type CollectionEntry } from 'astro:content'

import { getBlogCollection, getPostCollections, sortMDByDate } from '@/server'
import PostLayout from '@/layouts/BlogPost.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection())
  const collections = await getPostCollections()

  return posts.map((post) => {
    const normalizedId = post.id.replace(/\/index\.(md|mdx)$/, '').replace(/\.(md|mdx)$/, '').toLowerCase()
    const collection = collections.find((col) =>
      (col.data.bloglist || []).some((item) => item.toLowerCase() === normalizedId || item.toLowerCase() === post.id.toLowerCase())
    )
    return {
      params: { id: post.id },
      props: { post, posts, collection: collection ?? null }
    }
  })
}

type Props = {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  collection: CollectionEntry<'postCollections'> | null
}

const { post, posts, collection } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter} {collection}>
  <Content />
</PostLayout>
