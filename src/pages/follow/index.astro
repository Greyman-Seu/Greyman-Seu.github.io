---
import CommonPage from '@/layouts/CommonPage.astro'
import { Button } from '@/components/ui'
import { followDigests, type FollowDigest } from '@/data/follow'
import { ENABLE_REMOTE_FOLLOW_DATA, FOLLOW_DATA_BASE_URL, REQUIRE_REMOTE_FOLLOW_DATA } from '@/data/generated/follow-client'

const useRemoteFollowBootstrap = ENABLE_REMOTE_FOLLOW_DATA
const timelineMonthOptions = useRemoteFollowBootstrap
  ? []
  : Array.from(new Set(followDigests.map((digest: FollowDigest) => digest.date.slice(0, 7)))).sort().reverse()
const latestDigestDate = useRemoteFollowBootstrap ? '' : followDigests[0]?.date || ''
const latestDigestTime = latestDigestDate ? new Date(`${latestDigestDate}T00:00:00Z`).getTime() : 0

const visibleDigests = useRemoteFollowBootstrap
  ? []
  : followDigests.filter((digest: FollowDigest) => {
      if (!latestDigestTime) return true
      const digestTime = new Date(`${digest.date}T00:00:00Z`).getTime()
      return Math.floor((latestDigestTime - digestTime) / 86400000) < 30
    })

const headings = [
  { depth: 2, slug: 'favorite-sites', text: 'Favorite Sites' },
  { depth: 2, slug: 'daily-timeline', text: 'Daily Timeline' }
]

const favoriteLinks = [
  {
    category: '个人知识库',
    title: '个人飞书',
    note: '飞书 Wiki 入口，直接查看个人整理内容',
    href: 'https://my.feishu.cn/wiki/S0wswKSNSidL41kUYExcWUc3nMf'
  },
  {
    category: '常用网站',
    title: '机器人课题组',
    note: 'Open Robo Academy CV 资源页',
    href: 'https://openroboacademy.github.io/cv/'
  },
  {
    category: '常用网站',
    title: '机器人华人天团',
    note: 'Embodied Intelligence 华人研究者整理',
    href: 'https://github.com/Will-Gao/Embodied_Intelligence'
  },
  {
    category: '常用网站',
    title: '具身入门信息大全',
    note: 'Embodied AI Guide',
    href: 'https://github.com/tianxingchen/Embodied-AI-Guide'
  },
  {
    category: '公司主页',
    title: 'PI',
    note: 'Physical Intelligence',
    href: 'https://www.pi.website'
  },
  {
    category: '人物页',
    title: '个人主页',
    note: '进入独立人物页，后续统一扩展',
    href: '/people'
  }
] as const

const sourceBadgeClass = {
  arxiv: 'bg-blue-500/10 text-blue-700 dark:text-blue-300',
  wechat: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  x: 'bg-slate-500/10 text-slate-700 dark:text-slate-300',
  bilibili: 'bg-pink-500/10 text-pink-700 dark:text-pink-300'
} as const
---

<CommonPage title='Follow' {headings} info='/follow'>
  <div class='space-y-10'>
    <section class='space-y-6' aria-labelledby='favorite-sites'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='favorite-sites' class='m-0 text-2xl font-semibold'>Favorite Sites</h2>
        <p class='m-0 mt-1 text-sm text-muted-foreground'>把常看的具身资料、公司主页和人物入口放在顶部，减少来回翻找。</p>
      </div>

      <div class='grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3'>
        {favoriteLinks.map((link) => (
          <a
            class='block rounded-2xl border border-border bg-card p-5 no-underline shadow-sm transition-all hover:border-foreground/20 hover:bg-muted/30 hover:shadow-md'
            href={link.href}
            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}
          >
            <div class='space-y-3'>
              <p class='m-0 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground/80'>{link.category}</p>
              <div class='space-y-1'>
                <p class='m-0 text-base font-semibold text-foreground'>{link.title}</p>
                <p class='m-0 text-sm leading-6 text-muted-foreground'>{link.note}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class='space-y-6' aria-labelledby='daily-timeline'>
      <div class='border-b border-border/40 pb-3'>
        <h2 id='daily-timeline' class='m-0 text-2xl font-semibold'>Daily Timeline</h2>
        <p class='m-0 mt-1 text-sm text-muted-foreground'>这里只展示每日 digest 摘要与来源分布，不展开完整来源明细。</p>
      </div>

      <div class='grid grid-cols-1 gap-3 rounded-2xl border border-border bg-card p-4 md:grid-cols-2 xl:grid-cols-3'>
        <label class='flex flex-col gap-2 text-sm text-muted-foreground'>
          <span>Scope</span>
          <select id='timeline-scope' class='rounded-xl border border-border bg-background px-3 py-2 text-foreground outline-none transition-colors focus:border-primary'>
            <option value='recent'>Recent</option>
            <option value='archive'>Archive</option>
          </select>
        </label>

        <label id='timeline-month-wrap' class='hidden flex-col gap-2 text-sm text-muted-foreground'>
          <span>Month</span>
          <select id='timeline-month' class='rounded-xl border border-border bg-background px-3 py-2 text-foreground outline-none transition-colors focus:border-primary'>
            {timelineMonthOptions.map((month) => (
              <option value={month}>{month}</option>
            ))}
          </select>
        </label>
      </div>

      <div class='space-y-5'>
        {visibleDigests.length > 0 ? visibleDigests.map((digest: FollowDigest) => (
          <article class='follow-digest-card rounded-2xl border border-border bg-card p-5 shadow-sm' data-digest-date={digest.date}>
            <div class='flex flex-col gap-4'>
              <div class='flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between'>
                <div class='space-y-2'>
                  <div class='flex flex-wrap items-center gap-2'>
                    <h3 class='digest-date m-0 text-xl font-semibold text-foreground'>{digest.date}</h3>
                    <span class='rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary'>Daily digest</span>
                  </div>
                  <p class='digest-summary m-0 max-w-3xl text-sm leading-6 text-muted-foreground'>{digest.summary}</p>
                </div>

                <div class='digest-counts flex flex-wrap gap-2'>
                  {Object.entries(digest.counts).map(([source, count]) => (
                    <span class={`digest-count rounded-full px-2.5 py-1 text-xs font-medium ${sourceBadgeClass[source as keyof typeof sourceBadgeClass]}`} data-source={source}>
                      {source} {count}
                    </span>
                  ))}
                </div>
              </div>

              <div class='rounded-xl border border-border/50 bg-muted/20 p-4'>
                <p class='m-0 mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground/80'>Highlights</p>
                <ul class='digest-highlights space-y-2 pl-4 text-sm text-foreground/90'>
                  {digest.highlights.map((highlight: string) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>

              <div class='flex flex-wrap gap-2'>
                <Button title='Open arXiv feed' href='/follow/arxiv' />
                <Button title='Open X feed' href='/follow/x' />
                <Button title='Open WeChat feed' href='/follow/wechat' />
                <Button title='Open Bilibili feed' href='/follow/bilibili' />
              </div>
            </div>
          </article>
        )) : (
          <div class='rounded-2xl border border-dashed border-border px-5 py-10 text-center text-sm text-muted-foreground'>
            {useRemoteFollowBootstrap ? 'Loading remote Follow digests...' : 'No digest items available.'}
          </div>
        )}
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ followDataBaseUrl: FOLLOW_DATA_BASE_URL, requireRemoteFollowData: REQUIRE_REMOTE_FOLLOW_DATA, enableRemoteFollowData: ENABLE_REMOTE_FOLLOW_DATA }}>
    const sourceClassMap = {
      arxiv: 'bg-blue-500/10 text-blue-700 dark:text-blue-300',
      wechat: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
      x: 'bg-slate-500/10 text-slate-700 dark:text-slate-300',
      bilibili: 'bg-pink-500/10 text-pink-700 dark:text-pink-300',
    }

    const renderDigestCard = (digest) => {
      const countsHtml = Object.entries(digest.counts || {})
        .map(([source, count]) => {
          const className = sourceClassMap[source] || 'bg-muted text-muted-foreground'
          return `<span class="digest-count rounded-full px-2.5 py-1 text-xs font-medium ${className}" data-source="${source}">${source} ${count}</span>`
        })
        .join('')

      const highlightsHtml = Array.isArray(digest.highlights)
        ? digest.highlights.map((item) => `<li>${item}</li>`).join('')
        : ''

      return `
        <article class="follow-digest-card rounded-2xl border border-border bg-card p-5 shadow-sm" data-digest-date="${digest.date || ''}">
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="digest-date m-0 text-xl font-semibold text-foreground">${digest.date || ''}</h3>
                  <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">Daily digest</span>
                </div>
                <p class="digest-summary m-0 max-w-3xl text-sm leading-6 text-muted-foreground">${digest.summary || ''}</p>
              </div>
              <div class="digest-counts flex flex-wrap gap-2">${countsHtml}</div>
            </div>
            <div class="rounded-xl border border-border/50 bg-muted/20 p-4">
              <p class="m-0 mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground/80">Highlights</p>
              <ul class="digest-highlights space-y-2 pl-4 text-sm text-foreground/90">${highlightsHtml}</ul>
            </div>
            <div class="flex flex-wrap gap-2">
              <a class="group relative inline-flex items-center gap-x-2 rounded-lg bg-muted border border-border px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:bg-muted/80 hover:text-foreground no-underline" href="/follow/arxiv" data-astro-prefetch="true"><div class="relative flex items-center gap-x-2"><p class="my-0 transition-colors duration-200">Open arXiv feed</p></div></a>
              <a class="group relative inline-flex items-center gap-x-2 rounded-lg bg-muted border border-border px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:bg-muted/80 hover:text-foreground no-underline" href="/follow/x" data-astro-prefetch="true"><div class="relative flex items-center gap-x-2"><p class="my-0 transition-colors duration-200">Open X feed</p></div></a>
              <a class="group relative inline-flex items-center gap-x-2 rounded-lg bg-muted border border-border px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:bg-muted/80 hover:text-foreground no-underline" href="/follow/wechat" data-astro-prefetch="true"><div class="relative flex items-center gap-x-2"><p class="my-0 transition-colors duration-200">Open WeChat feed</p></div></a>
              <a class="group relative inline-flex items-center gap-x-2 rounded-lg bg-muted border border-border px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:bg-muted/80 hover:text-foreground no-underline" href="/follow/bilibili" data-astro-prefetch="true"><div class="relative flex items-center gap-x-2"><p class="my-0 transition-colors duration-200">Open Bilibili feed</p></div></a>
            </div>
          </div>
        </article>
      `
    }

    const hydrateRemoteFollowDigests = async () => {
      if (!enableRemoteFollowData) return
      if (!followDataBaseUrl) return
      try {
        const base = followDataBaseUrl.replace(/\/+$/, '')
        const [latestResponse, manifestResponse] = await Promise.all([
          fetch(`${base}/latest.json`, { cache: 'no-store' }),
          fetch(`${base}/manifest.json`, { cache: 'no-store' }),
        ])
        if (!latestResponse.ok) {
          if (requireRemoteFollowData) {
            throw new Error(`Failed to load remote latest.json: HTTP ${latestResponse.status}`)
          }
          return
        }
        const latest = await latestResponse.json()
        const manifest = manifestResponse.ok ? await manifestResponse.json() : null
        const timeline = document.querySelector('[aria-labelledby="daily-timeline"] .space-y-5')
        if (!(timeline instanceof HTMLElement)) return

        let remoteDigests = [latest]
        if (manifest && Array.isArray(manifest.days)) {
          const dailyPayloads = await Promise.all(
            manifest.days.map(async (day) => {
              const path = String(day.path || '')
              if (!path) return null
              const response = await fetch(`${base}/${path}`, { cache: 'no-store' })
              if (!response.ok) return null
              return response.json()
            })
          )
          remoteDigests = dailyPayloads.filter(Boolean)
        }

        if (remoteDigests.length) {
          timeline.innerHTML = remoteDigests.map((digest) => renderDigestCard(digest)).join('')
        }

        if (manifest && Array.isArray(manifest.sources)) {
          const sourceCards = Array.from(document.querySelectorAll('.follow-source-card'))
          sourceCards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return
            const sourceKey = card.dataset.source
            const source = manifest.sources.find((item) => item.source === sourceKey)
            if (!source) return
            const total = card.querySelector('.source-total')
            const latestBadge = card.querySelector('.source-latest')
            if (total) total.textContent = `${source.count || 0} item(s)`
            if (latestBadge) latestBadge.textContent = `latest ${latest.date || ''}`
          })
        }

      } catch (error) {
        console.warn('Failed to hydrate remote follow latest digest; keeping local static content.', error)
        const timeline = document.querySelector('[aria-labelledby="daily-timeline"] .space-y-5')
        if (timeline instanceof HTMLElement && timeline.children.length === 1) {
          const empty = timeline.querySelector('.rounded-2xl.border-dashed')
          if (empty instanceof HTMLElement) {
            empty.textContent = 'Failed to load remote Follow digests. Showing local fallback when available.'
          }
        }

        const sourceCards = Array.from(document.querySelectorAll('.follow-source-card'))
        sourceCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return
          const total = card.querySelector('.source-total')
          const description = card.querySelector('.source-description')
          if (total && total.textContent?.trim() === 'loading...') {
            total.textContent = 'fallback'
          }
          if (description && description.textContent?.includes('Waiting for remote Follow source summary.')) {
            description.textContent = 'Failed to load remote Follow source summary. Static fallback is not available in this build.'
          }
        })
      }
    }

    const bindTimelineScope = () => {
      const timeline = document.querySelector('[aria-labelledby="daily-timeline"] .space-y-5')
      const scopeNode = document.getElementById('timeline-scope')
      const monthNode = document.getElementById('timeline-month')
      const monthWrap = document.getElementById('timeline-month-wrap')
      if (!(timeline instanceof HTMLElement) || !(scopeNode instanceof HTMLSelectElement)) return

      const renderTimeline = () => {
        const scopeValue = scopeNode.value || 'recent'
        const monthValue = monthNode instanceof HTMLSelectElement ? monthNode.value : ''
        if (monthWrap instanceof HTMLElement) {
          monthWrap.classList.toggle('hidden', scopeValue !== 'archive')
          monthWrap.classList.toggle('flex', scopeValue === 'archive')
        }
        const cards = Array.from(timeline.querySelectorAll('.follow-digest-card'))
        const latestDate = cards.reduce((best, card) => {
          const value = card.getAttribute('data-digest-date') || ''
          return !best || value > best ? value : best
        }, '')
        const latestTime = latestDate ? new Date(`${latestDate}T00:00:00Z`).getTime() : 0
        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return
          const cardDate = card.getAttribute('data-digest-date') || ''
          let visible = true
          if (scopeValue === 'archive' && monthValue) {
            visible = cardDate.startsWith(monthValue)
          } else if (scopeValue === 'recent' && latestTime && cardDate) {
            const cardTime = new Date(`${cardDate}T00:00:00Z`).getTime()
            visible = Math.floor((latestTime - cardTime) / 86400000) < 30
          }
          card.classList.toggle('hidden', !visible)
        })
      }

      scopeNode.addEventListener('input', renderTimeline)
      scopeNode.addEventListener('change', renderTimeline)
      if (monthNode instanceof HTMLSelectElement) {
        monthNode.addEventListener('input', renderTimeline)
        monthNode.addEventListener('change', renderTimeline)
      }
      renderTimeline()
    }

    const initFollowIndexPage = () => {
      hydrateRemoteFollowDigests()
      bindTimelineScope()
    }

    document.addEventListener('DOMContentLoaded', initFollowIndexPage)
    document.addEventListener('astro:page-load', initFollowIndexPage)
  </script>
</CommonPage>
