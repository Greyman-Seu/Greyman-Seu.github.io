---
import { Image } from 'astro:assets'
import { Button, Card, Icon, Label } from '@/components/ui'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import BlogStats from '@/components/home/BlogStats.astro'
import PostPreview from '@/components/pages/PostPreview.astro'
import { DistributionSection } from '@/components/academic'
import { getBlogCollectionFiltered, sortMDByDate } from '@/utils/server'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const allPosts = await getBlogCollectionFiltered()
const sortedPosts = sortMDByDate(allPosts)
const pinnedPosts = sortedPosts.filter(p => p.data.pinned)
const recentPosts = pinnedPosts.length > 0 ? pinnedPosts.slice(0, 5) : sortedPosts.slice(0, 5)

const distributions = [
  {
    title: '主站',
    url: 'tenstep.top',
    platform: 'Cloudflare'
  },
  {
    title: 'GitHub Pages',
    url: 'greyman-seu.github.io',
    platform: 'GitHub'
  }
]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB966'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='flex flex-row items-center gap-x-6'>
        <Image
          src={avatar}
          alt='profile'
          class='h-36 w-auto rounded-lg border p-1'
          loading='eager'
        />
        <div class='flex flex-col gap-y-4'>
          <h1 class='text-3xl font-bold'>{config.author}</h1>
          <div class='flex flex-wrap gap-x-1 gap-y-1'>
            {config.personal?.location && (
              <Label title={config.personal.location}>
                <Icon name='location' class='size-4' slot='icon' />
              </Label>
            )}
            {config.personal?.githubUsername && (
              <Label
                title='Github'
                as='a'
                href={`https://github.com/${config.personal.githubUsername}`}
                target='_blank'
              >
                <Icon name='github' class='size-4' slot='icon' />
              </Label>
            )}
            {config.personal?.email && (
              <button
                id='email-copy-btn'
                data-email={config.personal.email}
                class='group relative flex flex-row items-center justify-center gap-x-2 rounded-lg bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 border border-border/50 px-3 py-2 text-sm font-medium text-muted-foreground backdrop-blur-sm transition-all duration-300 cursor-pointer hover:border-primary/40 hover:from-primary/10 hover:via-primary/5 hover:to-primary/10 hover:text-primary hover:shadow-md hover:shadow-primary/20 hover:-translate-y-0.5'
              >
                <div class='absolute inset-0 rounded-lg bg-gradient-to-r from-primary/0 via-primary/5 to-primary/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100' />
                <div class='relative flex items-center gap-x-2'>
                  <Icon name='email' class='size-4' />
                  <span id='email-copy-label'>Email</span>
                </div>
              </button>
            )}
            {config.personal?.googleScholar && (
              <Label title='Scholar' as='a' href={config.personal.googleScholar}>
                <Icon name='earth' class='size-4' slot='icon' />
              </Label>
            )}
          </div>
        </div>
      </div>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        {/* 标语 */}
        <p class='text-base font-semibold text-foreground'>五年一步，十步一人生。</p>

        {/* 深耕方向 */}
        <div>
          <p class='mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground/50'>深耕方向</p>
          <div class='flex flex-wrap gap-1.5'>
            {['VLM', 'VLA', '世界模型', '人体重建', '人机交互'].map(tag => (
              <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>{tag}</span>
            ))}
          </div>
        </div>

        {/* 经验维度 */}
        <div>
          <p class='mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground/50'>经验维度</p>
          <div class='grid grid-cols-2 gap-2 sm:grid-cols-4'>
            {[
              { label: '带队 & 项目', desc: '多年项目管理' },
              { label: '大规模量产落地', desc: '产品思维,守下限' },
              { label: '0-1 研发经验', desc: '从立项到量产级 POC，从理论到实践' },
              { label: '顶会经验', desc: '积累中…' }
            ].map(item => (
              <div class='rounded-xl border border-border bg-card px-3 py-2.5 text-center'>
                <p class='text-sm font-semibold text-foreground'>{item.label}</p>
                <p class='mt-0.5 text-xs text-muted-foreground'>{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        {/* 行事逻辑 */}
        <div>
          <p class='mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground/50'>行事逻辑</p>
          <div class='grid grid-cols-1 gap-2 sm:grid-cols-3'>
            {[
              { title: '底层', items: ['拒绝模糊', '利他精神', '吸引力法则'] },
              { title: '决策', items: ['谨慎决策', '一次做对'] },
              { title: '规划', items: ['乐观设想', '悲观计划', '愉快执行'] }
            ].map(item => (
              <div class='rounded-xl border border-border bg-card px-4 py-3'>
                <p class='mb-1.5 text-xs font-semibold text-primary'>{item.title}</p>
                <ul class='space-y-1'>
                  {item.items.map(i => (
                    <li class='text-sm text-muted-foreground'>{i}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        {/* 持续关注 */}
        <div>
          <p class='mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground/50'>持续关注</p>
          <div class='flex flex-wrap gap-1.5'>
            {['机器人', '自动驾驶', 'VR / MR / XR', '3D 打印'].map(tag => (
              <span class='rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground'>{tag}</span>
            ))}
          </div>
        </div>

        {/* 彩蛋 */}
        <p class='text-xs italic text-muted-foreground/40'>
          如果你对算法不感兴趣——老夫作为官方认证营养师，也可以浅谈养生之道。
        </p>

        <div class='flex flex-wrap items-center gap-2 self-end'>
          <Button title='代表成果' class='w-fit' href='/works' style='plain' />
          <Button title='简历' class='w-fit' href='/resume' style='ahead' />
        </div>
      </Section>
      <Section title='Annual'>
        <div class='flex items-center gap-2 text-sm text-muted-foreground'>
          <span>2026 年度代号</span>
          <span class='rounded-full bg-primary/10 px-3 py-0.5 font-semibold text-primary'>「破军星」</span>
          <Button title='历年代号' class='ml-auto w-fit' href='/annual' style='ahead' />
        </div>
      </Section>
      <Section title='Experience'>
        <Card
          as='a'
          heading='上海人工智能实验室'
          subheading='具身中心'
          date='2025.03 — 至今'
          href='/resume#experience'
        >
        </Card>
        <Card
          as='a'
          heading='地平线 / 红西瓜半导体'
          subheading='HALO 座舱部门'
          date='2021.02 — 2025.03'
          href='/resume#experience'
        >
        </Card>
        <Button title='完整经历' class='w-fit self-end' href='/resume#experience' style='ahead' />
      </Section>
      <Section title='Education'>
        <Card
          as='a'
          heading='东南大学'
          subheading='工程热物理'
          date='2016.09 — 2019.07'
          href='/resume#education'
        >
        </Card>
        <Card
          as='a'
          heading='南京林业大学'
          subheading='热能与动力工程'
          date='2012.09 — 2016.07'
          href='/resume#education'
        >
        </Card>
        <Button title='完整教育' class='w-fit self-end' href='/resume#education' style='ahead' />
      </Section>
      {recentPosts.length > 0 && (
        <Section title={pinnedPosts.length > 0 ? 'Pinned' : 'Recent Posts'}>
          <ul class='flex flex-col gap-y-4'>
            {recentPosts.map(post => (
              <PostPreview post={post} />
            ))}
          </ul>
          <Button title='全部文章' class='w-fit self-end' href='/blog/other' style='ahead' />
        </Section>
      )}
      <Section title='Statistics'>
        <BlogStats blogStartDate={config.personal?.blogStartDate ? new Date(config.personal.blogStartDate) : new Date('2024-06-15')} />
      </Section>
      <Section title='Distribution'>
        <p class='text-muted-foreground text-sm'>
          本站在多个平台部署，如遇访问问题可选择其他镜像站点，所有站点内容保持同步更新。
          个人网站始于 2026 年。
        </p>
        <DistributionSection {distributions} />
      </Section>
      <Section title='Copyright'>
        <p class='text-muted-foreground text-sm'>
          本站所有原创内容，除非特别说明，均以 <a href='https://creativecommons.org/licenses/by-nc-sa/4.0/' class='underline underline-offset-2'>CC BY-NC-SA 4.0</a> 协议授权。
          转载须注明作者及原文链接，不得用于商业目的。
          本站部分图片素材来源于 Pixiv 等平台，均已注明原作链接；如有侵权，请联系我删除。
        </p>
      </Section>
    </div>
  </main>
</PageLayout>

<script>
  function spawnFireworks(target: HTMLElement) {
    const emojis = ['🎉', '✨', '🎊', '⭐', '💫', '🌟', '🎈']
    const rect = target.getBoundingClientRect()
    const cx = rect.left + rect.width / 2
    const cy = rect.top + rect.height / 2

    for (let i = 0; i < 12; i++) {
      const el = document.createElement('span')
      el.textContent = emojis[i % emojis.length]
      el.style.cssText = `
        position: fixed;
        left: ${cx}px;
        top: ${cy}px;
        font-size: ${13 + Math.random() * 8}px;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.65s ease-out;
      `
      document.body.appendChild(el)

      const angle = (i / 12) * 2 * Math.PI
      const dist = 45 + Math.random() * 45
      const dx = Math.cos(angle) * dist
      const dy = Math.sin(angle) * dist

      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.1)`
        el.style.opacity = '0'
      }))

      setTimeout(() => el.remove(), 750)
    }
  }

  const btn = document.getElementById('email-copy-btn') as HTMLElement | null
  const label = document.getElementById('email-copy-label') as HTMLElement | null

  if (btn && label) {
    btn.addEventListener('click', () => {
      const email = (btn as HTMLButtonElement).dataset.email || ''
      navigator.clipboard.writeText(email).then(() => {
        // 烟花爆发
        spawnFireworks(btn)

        // 过渡到点赞
        setTimeout(() => {
          const svg = btn.querySelector('svg')
          if (svg) {
            svg.style.display = 'none'
            const thumb = document.createElement('span')
            thumb.id = 'email-thumb'
            thumb.textContent = '👍'
            thumb.style.cssText = 'font-size:1rem; animation: thumbPop 0.3s ease-out;'
            svg.parentNode!.insertBefore(thumb, svg)
          }
          label.textContent = '复制成功'
        }, 400)

        // 复原
        setTimeout(() => {
          label.textContent = 'Email'
          const thumb = document.getElementById('email-thumb')
          if (thumb) thumb.remove()
          const svg = btn.querySelector('svg')
          if (svg) svg.style.display = ''
        }, 2600)
      })
    })
  }
</script>

<style>
  @keyframes thumbPop {
    0%   { transform: scale(0); }
    70%  { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
</style>
