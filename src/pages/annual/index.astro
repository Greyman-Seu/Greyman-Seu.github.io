---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  title: '年度规划',
  description: '每一年的代号、壁纸与主要矛盾'
}

// 从最新年份到最早，壁纸放在 /public/annual/{year}.jpg
const plans = [
  { year: 2026, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2025, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2024, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2023, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2022, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2021, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2020, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2019, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2018, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2017, codename: '[代号]', contradiction: '[主要矛盾]' },
  { year: 2016, codename: '[代号]', contradiction: '[主要矛盾]' }
]

// 每年各自的渐变色（图片不存在时作为背景）
const gradients = [
  ['#6366f1', '#8b5cf6'], // 2026 indigo → violet
  ['#0ea5e9', '#6366f1'], // 2025 sky → indigo
  ['#10b981', '#0ea5e9'], // 2024 emerald → sky
  ['#f59e0b', '#ef4444'], // 2023 amber → red
  ['#ec4899', '#a855f7'], // 2022 pink → purple
  ['#14b8a6', '#0ea5e9'], // 2021 teal → sky
  ['#f97316', '#f59e0b'], // 2020 orange → amber
  ['#84cc16', '#10b981'], // 2019 lime → emerald
  ['#e879f9', '#ec4899'], // 2018 fuchsia → pink
  ['#64748b', '#475569'], // 2017 slate
  ['#0891b2', '#0284c7']  // 2016 cyan → blue
]
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate mb-10'>
      <h1 class='text-3xl font-bold'>年度规划</h1>
      <p class='mt-2 text-muted-foreground'>每一年的代号、壁纸与主要矛盾。</p>
    </div>

    <section id='content' class='animate'>
      <div class='grid gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {plans.map((plan, i) => {
          const [from, to] = gradients[i]
          return (
            <div class='group overflow-hidden rounded-2xl border border-border bg-card transition-all duration-300 hover:border-foreground/20 hover:shadow-xl'>
              {/* 壁纸区域 */}
              <div class='relative aspect-video overflow-hidden'>
                {/* 渐变兜底背景 */}
                <div
                  class='absolute inset-0'
                  style={`background: linear-gradient(135deg, ${from}40, ${to}25)`}
                />
                {/* 壁纸图片，不存在时隐藏，显示渐变 */}
                <img
                  src={`/annual/${plan.year}.jpg`}
                  alt={`${plan.year} wallpaper`}
                  class='absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105'
                  onerror='this.style.display="none"'
                  loading='lazy'
                />
                {/* 底部渐变遮罩，保证文字可读 */}
                <div class='absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent' />
                {/* 年份数字 */}
                <span
                  class='absolute right-4 top-3 text-6xl font-black leading-none select-none'
                  style={`color: ${from}; opacity: 0.25;`}
                >
                  {plan.year}
                </span>
                <span class='absolute bottom-3 left-4 text-3xl font-black text-white drop-shadow-lg'>
                  {plan.year}
                </span>
              </div>

              {/* 内容区域 */}
              <div class='px-4 pb-4 pt-3'>
                <div class='mb-2 flex items-center gap-2'>
                  <span
                    class='rounded-full px-2.5 py-0.5 text-xs font-semibold'
                    style={`background: ${from}20; color: ${from};`}
                  >
                    代号
                  </span>
                  <span class='font-semibold text-foreground'>「{plan.codename}」</span>
                </div>
                <p class='text-sm leading-relaxed text-muted-foreground'>{plan.contradiction}</p>
              </div>
            </div>
          )
        })}
      </div>
    </section>
  </main>
</PageLayout>
