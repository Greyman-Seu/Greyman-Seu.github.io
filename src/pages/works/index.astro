---
import PageLayout from '@/layouts/CommonPage.astro'
import { PublicationSection, ResearchProjectSection } from '@/components/academic'
import { Icon } from '@/components/ui'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'publications', text: '论文' },
  { depth: 2, slug: 'projects', text: '项目' },
  { depth: 2, slug: 'open-source-projects', text: '开源项目' },
  { depth: 2, slug: 'media-sharing', text: '自媒体分享' }
]

const openSourceProjects = [
  {
    title: 'InternVLA-M1',
    description: '面向通用机器人策略的 Vision-Language-Action 开源框架，强调 spatially guided、dual-system 和 dual-supervision 训练范式，将语言理解、空间感知与动作预测统一到同一套框架中。我主要负责 Sys2 pretrain，以及长任务拆解能力相关设计与落地。后续进一步延伸到 StarVLA，形成更模块化、可扩展的 VLA 开发生态。',
    category: '具身智能 / VLA / 开源',
    status: 'active' as const,
    links: [
      { type: 'github', href: 'https://github.com/InternRobotics/InternVLA-M1', label: 'GitHub' },
      { type: 'github', href: 'https://github.com/starVLA/starVLA', label: 'StarVLA · 1.5k Stars' },
      { type: 'huggingface', href: 'https://huggingface.co/InternRobotics/InternVLA-M1', label: 'Hugging Face' },
      { type: 'paper', href: 'https://arxiv.org/abs/2510.13778', label: 'Paper' }
    ]
  },
  {
    title: 'vllm-omni-internvla-a1',
    description: '围绕 vLLM-Omni 的多模态 serving 基座，对 InternVLA-A1 做推理与部署侧适配，使模型更容易接入统一服务框架、接口协议和工程化部署链路。我这里主要负责将 A1 适配到 vLLM 框架。',
    category: 'Serving / 多模态部署 / 开源',
    status: 'active' as const,
    links: [
      { type: 'github', href: 'https://github.com/Greyman-Seu/vllm-omni-internvla-a1', label: 'GitHub' },
      { type: 'doc', href: 'https://vllm-omni.readthedocs.io/en/latest/', label: 'vLLM-Omni' }
    ]
  },
  {
    title: 'Quest_Tele',
    description: '基于 Meta Quest 3 的 VR 双手位姿采集与机器人遥操作工具，支持手柄模式与人手追踪模式，通过局域网 HTTP / JSON 实时发送头显、手腕、手柄和 24 关节数据，并提供 Python 侧接收与可视化监控脚本，便于快速接入遥操作与采集流程。',
    category: 'VR / 遥操作 / 机器人工具 / 开源',
    status: 'active' as const,
    links: [
      { type: 'github', href: 'https://github.com/Greyman-Seu/Quest_Tele', label: 'GitHub' }
    ]
  }
]

const projects = [
  {
    title: '项目名称',
    description: '项目描述：在此介绍项目背景、你的角色与核心成果。',
    category: '量产 / 研发 / Demo',
    status: 'active' as const,
    links: []
  }
]

const mediaSharing = [
  {
    title: '分享主题',
    description: '分享描述：在此放文章、视频、公开分享或系列输出。',
    category: '博客 / 视频 / 分享',
    status: 'active' as const,
    links: [
      { type: 'site', href: '/blog/other', label: 'Blog' },
    ]
  }
]
---

<PageLayout title='Works' {headings} info={{ slug: '/works', hideComment: true }}>
  {/* 页面说明 */}
  <p class='text-muted-foreground'>
    这里收录可以拿出手的典型成果，包括论文、项目、开源项目与自媒体分享。
  </p>

  {/* ── 论文 ── */}
  <h2 id='publications'>论文<a class='anchor' href='#publications'>#</a></h2>
  {config.personal?.googleScholar && (
    <div class='not-prose'>
      <a
        href={config.personal.googleScholar}
        target='_blank'
        class='inline-flex items-center gap-x-2 rounded-lg border border-border/50 bg-muted/60 px-3 py-1.5 text-sm font-medium text-muted-foreground transition-all hover:border-primary/40 hover:text-primary hover:-translate-y-0.5'
      >
        <Icon name='earth' class='size-4' />
        <span>Google Scholar</span>
      </a>
    </div>
  )}
  <PublicationSection
    publications={[
      {
        title: 'ST4VLA: Spatially Guided Training for Vision-Language-Action Models',
        authors: [
          { name: 'Jinhui Ye', isEqual: true },
          { name: 'Fangjing Wang', isEqual: true },
          { name: 'Ning Gao', isEqual: true },
          { name: 'Junqiu Yu', isEqual: true },
          { name: 'Yangkun Zhu', isMe: true },
          { name: 'Yilun Chen', role: 'corresponding' }
        ],
        venue: 'ICLR 2026',
        year: '2026',
        type: 'conference',
        abstract: '提出 Spatially Guided Training，将 spatial grounding pre-training 与 spatially guided action post-training 串联起来，在 SimplerEnv 上取得显著提升。',
        links: [
          { type: 'arxiv', href: 'https://arxiv.org/abs/2602.10109' }
        ],
        status: 'accepted'
      },
      {
        title: 'InternVLA-M1: A Spatially Guided Vision-Language-Action Framework for Generalist Robot Policy',
        authors: [
          { name: 'Yilun Chen', isCoreContributor: true },
          { name: 'Ning Gao', isCoreContributor: true },
          { name: 'Jiangmiao Pang', isCoreContributor: true },
          { name: 'Bolun Wang', isCoreContributor: true },
          { name: 'Fangjing Wang', isCoreContributor: true },
          { name: 'Jinhui Ye', isCoreContributor: true },
          { name: 'Junqiu Yu', isCoreContributor: true },
          { name: 'Jinyu Zhang', isCoreContributor: true },
          { name: 'Yangkun Zhu', isMe: true, isCoreContributor: true }
        ],
        authorsAlphabetical: true,
        venue: 'ArXiv Technical Report',
        year: '2025',
        type: 'preprint',
        abstract: '将空间 grounding 与机器人控制统一到同一框架，通过两阶段 spatially guided 训练提升 instruction following、泛化与长任务鲁棒性。',
        links: [
          { type: 'arxiv', href: 'https://arxiv.org/abs/2510.13778' },
          { type: 'github', href: 'https://github.com/InternRobotics/InternVLA-M1' },
          { type: 'model', href: 'https://huggingface.co/InternRobotics/InternVLA-M1' }
        ],
        status: 'preprint'
      },
      {
        title: 'InternVLA-A1: Unifying Understanding, Generation and Action for Robotic Manipulation',
        authors: [
          { name: 'Junhao Cai' },
          { name: 'Yang Li' },
          { name: 'Haoxiang Ma' },
          { name: 'Jiangmiao Pang' },
          { name: 'Zherui Qiu' },
          { name: 'Yang Tian' },
          { name: 'Jia Zeng', role: 'project-leader' },
          { name: 'Hongrui Zhu' },
          { name: 'Yangkun Zhu', isMe: true }
        ],
        venue: 'ArXiv Preprint',
        year: '2026',
        type: 'preprint',
        abstract: '统一 understanding、generation 与 action 的机器人操作模型，以 Mixture-of-Transformers 协同 scene understanding、visual foresight 和 action execution。',
        links: [
          { type: 'arxiv', href: 'https://arxiv.org/abs/2601.02456' }
        ],
        status: 'preprint'
      }
    ]}
  />

  {/* ── 项目 ── */}
  <h2 id='projects'>项目<a class='anchor' href='#projects'>#</a></h2>
  <ResearchProjectSection projects={projects} />

  {/* ── 开源项目 ── */}
  <h2 id='open-source-projects'>开源项目<a class='anchor' href='#open-source-projects'>#</a></h2>
  <ResearchProjectSection projects={openSourceProjects} />

  {/* ── 自媒体分享 ── */}
  <h2 id='media-sharing'>自媒体分享<a class='anchor' href='#media-sharing'>#</a></h2>
  <ResearchProjectSection projects={mediaSharing} />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
