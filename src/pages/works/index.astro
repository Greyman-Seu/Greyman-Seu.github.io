    image: 'hand-gt-system.png',
    description: '面向车载人手重建方向建设长期基础数据能力，围绕 GT 系统构建标注、验证与算法迭代底座，为后续 TOF、单目、多目等路线的人手重建提供统一支撑。',
    category: '数据基建 / GT 系统 / 人手重建',
    status: 'completed' as const,
