                          <span
                            class:list={[
                              'mt-[0.55rem] size-1 shrink-0 rounded-full bg-current opacity-35',
                              section.label === 'A' && 'opacity-45'
                            ]}
                          ></span>
                          <div class='min-w-0'>
                            {typeof text === 'string' ? (
                              section.label === 'R' ? (
                                <p class:list={[getProjectSectionTextClass(section.label)]}>
                                  <span set:html={highlightProjectResultText(text)} />
                                </p>
                              ) : (
                                <p class:list={[getProjectSectionTextClass(section.label)]}>{text}</p>
                              )
                            ) : (
