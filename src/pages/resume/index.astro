  },
  {
    company: '地平线',
    role: '研究院 · 助理研究员 / A 班班长 → DMS · 算法工程师',
    date: '2019.07 — 2020.02',
    location: '南京',
    details: [
      '研究院 A 班班长；转 DMS 后负责疲劳检测，支撑地平线首款量产车载芯片 J2 发版'
    ]
  }
