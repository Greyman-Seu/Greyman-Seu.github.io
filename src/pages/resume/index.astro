---

<PageLayout title='Resume' {headings} info='/resume'>
  <div class='resume-page'>

  {/* ── 个人简介 ── */}
  <h2 id='summary'>个人简介<a class='anchor' href='#summary'>#</a></h2>
  <p>
    魔武双修——兼具创新力与组织力，既要在前沿无人区探路，也要把想法落成真实跑在产品上的东西。
  </p>
  <p>
    7 年车载 AI 算法经验，5 年带队。量产侧，作为 HALO 团队核心成员经历了地平线芯片首次量产，服务十数款车型；研发侧，多次主导大型车展准量产级项目，行业 TOP；科研侧，深度贡献 InternVLA 系列工作，沉淀顶会经验中。
  </p>
  <p>
    在意技术的天花板，也在意技术的地板。
  </p>
  <div class='not-prose flex flex-wrap gap-2'>
    {config.personal?.googleScholar && (
      <a
        href={config.personal.googleScholar}
        target='_blank'
        class='resume-quick-action flex flex-row items-center gap-x-2 rounded-lg border border-border/50 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-300 hover:border-primary/40 hover:text-primary hover:-translate-y-0.5'
      >
        <Icon name='earth' class='size-4' />
        <span>Scholar</span>
      </a>
    )}
    <button
      id='resume-email-btn'
      data-email={config.personal?.email}
      class='resume-quick-action group relative flex flex-row items-center justify-center gap-x-2 rounded-lg bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 border border-border/50 px-3 py-2 text-sm font-medium text-muted-foreground backdrop-blur-sm transition-all duration-300 cursor-pointer hover:border-primary/40 hover:from-primary/10 hover:via-primary/5 hover:to-primary/10 hover:text-primary hover:shadow-md hover:shadow-primary/20 hover:-translate-y-0.5'
    >
      <div class='absolute inset-0 rounded-lg bg-gradient-to-r from-primary/0 via-primary/5 to-primary/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100' />
      <div class='relative flex items-center gap-x-2'>
        <Icon name='email' class='size-4' />
        <span id='resume-email-label'>联系我</span>
      </div>
    </button>
  </div>  {/* end not-prose flex */}

  {/* ── 教育背景 ── */}
  <h2 id='education'>教育背景<a class='anchor' href='#education'>#</a></h2>
  <div class='not-prose flex flex-col gap-3'>
    {recentEducation.map((item) => (
      <div class='resume-panel rounded-xl border border-border bg-card px-5 py-4'>
        <div class='flex flex-wrap items-start justify-between gap-2'>
          <div>
            <div class='flex flex-wrap items-center gap-2'>
              <p class='font-semibold text-foreground'>{item.school}</p>
              {item.badge && (
                <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
                  {item.badge}
                </span>
              )}
            </div>
            <p class='mt-0.5 text-sm text-muted-foreground'>{item.degree}</p>
          </div>
          <span class='shrink-0 rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary'>
            {item.date}
          </span>
        </div>
        <ul class='mt-3 space-y-1.5 border-t border-border/50 pt-3'>
          {item.details.map((d) => (
            <li class='flex items-start gap-2 text-sm text-muted-foreground'>
              <span class='mt-[0.4rem] size-1.5 shrink-0 rounded-full bg-primary/50'></span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {olderEducation.length > 0 && (
      <details class='resume-section-details group'>
        <summary class='resume-section-summary'>
          <span>更多教育经历</span>
          <span class='resume-section-chevron'>⌄</span>
        </summary>
        <div class='mt-3 flex flex-col gap-3'>
          {olderEducation.map((item) => (
            <div class='resume-panel rounded-xl border border-border bg-card px-5 py-4'>
              <div class='flex flex-wrap items-start justify-between gap-2'>
                <div>
                  <div class='flex flex-wrap items-center gap-2'>
                    <p class='font-semibold text-foreground'>{item.school}</p>
                    {item.badge && (
                      <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <p class='mt-0.5 text-sm text-muted-foreground'>{item.degree}</p>
                </div>
                <span class='shrink-0 rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary'>
                  {item.date}
                </span>
              </div>
              <ul class='mt-3 space-y-1.5 border-t border-border/50 pt-3'>
                {item.details.map((d) => (
                  <li class='flex items-start gap-2 text-sm text-muted-foreground'>
                    <span class='mt-[0.4rem] size-1.5 shrink-0 rounded-full bg-primary/50'></span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>

  {/* ── 工作经历 ── */}
  <h2 id='experience'>工作经历<a class='anchor' href='#experience'>#</a></h2>
  <div class='not-prose flex flex-col gap-3'>
    {recentExperience.map((item) => (
      <div class='resume-panel rounded-xl border border-border bg-card px-5 py-4'>
        <div class='flex flex-wrap items-start justify-between gap-2'>
          <div>
            <p class='font-semibold text-foreground'>{item.company}</p>
            <p class='mt-0.5 text-sm text-muted-foreground'>{item.role}</p>
          </div>
          <div class='flex flex-col items-end gap-1'>
            <span class='shrink-0 rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary'>
              {item.date}
            </span>
            <span class='text-xs text-muted-foreground'>{item.location}</span>
          </div>
        </div>
        <ul class='mt-3 space-y-1.5 border-t border-border/50 pt-3'>
          {item.details.map((d) => (
            <li class='flex items-start gap-2 text-sm text-muted-foreground'>
              <span class='mt-[0.4rem] size-1.5 shrink-0 rounded-full bg-primary/50'></span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {olderExperience.length > 0 && (
      <details class='resume-section-details group'>
        <summary class='resume-section-summary'>
          <span>更多工作经历</span>
          <span class='resume-section-chevron'>⌄</span>
        </summary>
        <div class='mt-3 flex flex-col gap-3'>
          {olderExperience.map((item) => (
            <div class='resume-panel rounded-xl border border-border bg-card px-5 py-4'>
              <div class='flex flex-wrap items-start justify-between gap-2'>
                <div>
                  <p class='font-semibold text-foreground'>{item.company}</p>
                  <p class='mt-0.5 text-sm text-muted-foreground'>{item.role}</p>
                </div>
                <div class='flex flex-col items-end gap-1'>
                  <span class='shrink-0 rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary'>
                    {item.date}
                  </span>
                  <span class='text-xs text-muted-foreground'>{item.location}</span>
                </div>
              </div>
              <ul class='mt-3 space-y-1.5 border-t border-border/50 pt-3'>
                {item.details.map((d) => (
                  <li class='flex items-start gap-2 text-sm text-muted-foreground'>
                    <span class='mt-[0.4rem] size-1.5 shrink-0 rounded-full bg-primary/50'></span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>

  {/* ── 技术技能 ── */}
  <h2 id='skills'>技术技能<a class='anchor' href='#skills'>#</a></h2>
  <div class='not-prose resume-panel rounded-xl border border-border bg-card px-5 py-4'>
    <dl class='space-y-3'>
      {skills.map((row) => (
        <div class='flex flex-wrap items-start gap-x-3 gap-y-1.5'>
          <dt class='w-24 shrink-0 pt-0.5 text-sm font-medium text-foreground'>{row.label}</dt>
          <dd class='flex flex-1 flex-wrap gap-1.5'>
            {row.items.map((item) => (
              <span class='rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground'>
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>

  {/* ── 项目经历 ── */}
  <h2 id='projects'>项目经历<a class='anchor' href='#projects'>#</a></h2>
  <div class='not-prose flex flex-col gap-2.5'>
    {projects.map((item) => (
      <div
        class:list={[
          'resume-project-card rounded-2xl border bg-card/95 px-5 py-4 shadow-sm shadow-black/[0.02] transition-colors',
          item.highlight
            ? 'border-primary/25 bg-primary/[0.025] shadow-primary/5 hover:border-primary/35'
            : 'border-border/80 hover:border-border'
        ]}
      >
        <div class='space-y-2.5'>
          <div class='space-y-1.5'>
            <div class='flex items-start justify-between gap-3'>
              <div class='min-w-0 flex-1'>
                <p class='text-[15px] font-semibold leading-6 text-foreground'>{item.name}</p>
              </div>
              <div class='flex shrink-0 items-center gap-2 pt-0.5'>
                {item.highlight && (
                  <span class='rounded-full bg-primary/12 px-2 py-0.5 text-[10px] font-semibold tracking-[0.08em] text-primary'>
                    {item.highlight}
                  </span>
                )}
                {item.href && (
                  <a
                    href={item.href}
                    class='text-xs text-primary transition-opacity hover:opacity-70'
                    target={item.href.startsWith('/works') ? undefined : '_blank'}
                  >
                    {item.href.startsWith('/works') ? 'Works ↗' : 'GitHub ↗'}
                  </a>
                )}
              </div>
            </div>
            <div class='flex flex-wrap items-center gap-1.5'>
              {item.roleTags && item.roleTags.length > 0 ? (
                item.roleTags.map((role) => (
                  <span class='rounded-full bg-secondary/80 px-2.5 py-0.5 text-[11px] text-muted-foreground'>
                    {role}
                  </span>
                ))
              ) : (
                <span class='rounded-full bg-secondary/80 px-2.5 py-0.5 text-[11px] text-muted-foreground'>
                  {item.type}
                </span>
              )}
              <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary'>
                {item.date}
              </span>
            </div>
          </div>
          {(item.company || item.projectGroup || item.algorithmGroup) && (
            <div class='flex flex-wrap gap-1.5 border-t border-border/50 pt-2.5 text-[11px] text-muted-foreground'>
              {item.company && (
                <span class='rounded-full bg-muted/80 px-2.5 py-0.5'>
                  公司：{item.company}
                </span>
              )}
              {item.projectGroup && (
                <span class='rounded-full bg-muted/80 px-2.5 py-0.5'>
                  项目组：{item.projectGroup}
                </span>
              )}
              {item.algorithmGroup && (
                <span class='rounded-full bg-muted/80 px-2.5 py-0.5'>
                  算法组：{item.algorithmGroup}
                </span>
              )}
            </div>
          )}
          {item.workLinks && item.workLinks.length > 0 && (
            <div class='flex flex-wrap items-center gap-1.5 border-t border-border/50 pt-2.5 text-[11px] text-muted-foreground'>
              <span class='rounded-full bg-muted/80 px-2.5 py-0.5'>Works</span>
              {item.workLinks.map((link) => (
                <a
                  href={link.href}
                  class='rounded-full bg-primary/10 px-2.5 py-0.5 font-medium text-primary transition-colors hover:bg-primary/15'
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
        {item.sections ? (
          <div class='project-card-details mt-3.5 border-t border-border/50 pt-3'>
            <div class='space-y-2'>
              {mergeProjectSections(item.sections)
                .filter((section) => !isProjectSectionPrimary(section.label))
                .map((section, index) => (
                  <div
                    class:list={[
                      'resume-project-section grid gap-2 sm:grid-cols-[64px_minmax(0,1fr)] sm:gap-3.5',
                      getProjectSectionRowClass(section.label),
                      index !== 0 && 'border-t border-dashed border-border/50'
                    ]}
                    data-section-label={section.label}
                  >
                    <div class='sm:pt-0.5'>
                      <span
                        class:list={[
                          'resume-project-badge inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.08em]',
                          getProjectSectionBadgeClass(section.label)
                        ]}
                      >
                        {section.label}
                      </span>
                    </div>
                    <div class='space-y-1.5'>
                      {section.texts.map((text) => (
                        <div class='flex items-start gap-2'>
                          {section.texts.length > 1 ? (
                            <span
                              class:list={[
                                'mt-[0.55rem] size-1 shrink-0 rounded-full bg-current opacity-35',
                                section.label === 'R' && 'opacity-50'
                              ]}
                            ></span>
                          ) : null}
                          {typeof text === 'string' ? (
                            section.label === 'R' ? (
                              <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>
                                <span set:html={highlightProjectResultText(text)} />
                              </p>
                            ) : (
                              <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>{text}</p>
                            )
                          ) : (
                            <div class='space-y-1'>
                              <p class='resume-project-text-title text-sm font-semibold leading-6 text-foreground/90'>
                                {text.title}
                              </p>
                              <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>
                                {text.body}
                              </p>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
            </div>

            <div class='project-card-extra mt-2 space-y-2 border-t border-border/40 pt-3'>
              {mergeProjectSections(item.sections)
                .filter((section) => isProjectSectionPrimary(section.label))
                .map((section, index) => (
                  <div
                    class:list={[
                      'resume-project-section grid gap-2 sm:grid-cols-[64px_minmax(0,1fr)] sm:gap-3.5',
                      getProjectSectionRowClass(section.label),
                      index !== 0 && 'border-t border-dashed border-border/50'
                    ]}
                    data-section-label={section.label}
                  >
                    <div class='sm:pt-0.5'>
                      <span
                        class:list={[
                          'resume-project-badge inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.08em]',
                          getProjectSectionBadgeClass(section.label)
                        ]}
                      >
                        {section.label}
                      </span>
                    </div>
                    <div class='space-y-1.5'>
                      {section.texts.map((text) => (
                        <div
                          class:list={[
                            'flex items-start gap-2',
                            section.label === 'A' && 'rounded-lg bg-background/60 px-2.5 py-2'
                          ]}
                        >
                          <span
                            class:list={[
                              'mt-[0.55rem] size-1 shrink-0 rounded-full bg-current opacity-35',
                              section.label === 'A' && 'opacity-45'
                            ]}
                          ></span>
                          <div class='min-w-0'>
                            {typeof text === 'string' ? (
                              section.label === 'R' ? (
                                <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>
                                  <span set:html={highlightProjectResultText(text)} />
                                </p>
                              ) : (
                                <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>{text}</p>
                              )
                            ) : (
                              <div class='space-y-1'>
                                <p class='resume-project-text-title text-sm font-semibold leading-6 text-foreground/90'>
                                  {text.title}
                                </p>
                                <p class:list={['resume-project-text', getProjectSectionTextClass(section.label)]}>
                                  {text.body}
                                </p>
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
            </div>
            <button
              type='button'
              class='project-card-summary mt-0.5 flex h-3 w-full cursor-pointer items-end justify-center text-primary/40'
              aria-expanded='false'
            >
              <span class='project-chevron transition-all duration-200 ease-out'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  viewBox='0 0 20 20'
                  fill='currentColor'
                  class='size-3'
                  aria-hidden='true'
                >
                  <path
                    fill-rule='evenodd'
                    d='M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z'
                    clip-rule='evenodd'
                  ></path>
                </svg>
              </span>
            </button>
          </div>
        ) : (
          <ul class='mt-3 space-y-1.5 border-t border-border/50 pt-3'>
            {item.details?.map((d) => (
              <li class='flex items-start gap-2 text-sm text-muted-foreground'>
                <span class='mt-[0.4rem] size-1.5 shrink-0 rounded-full bg-primary/50'></span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
  </div>

  <Comment slot='bottom' />
</PageLayout>

<script>
  const btn = document.getElementById('resume-email-btn') as HTMLElement | null
  const label = document.getElementById('resume-email-label') as HTMLElement | null
  const projectToggleButtons = document.querySelectorAll<HTMLButtonElement>('.project-card-summary')

  if (btn && label) {
    btn.addEventListener('click', () => {
      const email = (btn as HTMLButtonElement).dataset.email || ''
      navigator.clipboard.writeText(email).then(() => {
        setTimeout(() => {
          const svg = btn.querySelector('svg')
          if (svg) {
            svg.style.display = 'none'
            const thumb = document.createElement('span')
            thumb.id = 'resume-thumb'
            thumb.textContent = '👍'
            thumb.style.cssText = 'font-size:1rem; animation: thumbPop 0.3s ease-out;'
            svg.parentNode!.insertBefore(thumb, svg)
          }
          label.textContent = '邮箱已复制'
        }, 200)

        setTimeout(() => {
          label.textContent = '联系我'
          const thumb = document.getElementById('resume-thumb')
          if (thumb) thumb.remove()
          const svg = btn.querySelector('svg')
          if (svg) svg.style.display = ''
        }, 2400)
      })
    })
  }

  projectToggleButtons.forEach((toggleButton) => {
    toggleButton.addEventListener('click', () => {
      const cardDetails = toggleButton.closest('.project-card-details')
      if (!cardDetails) return

      const isExpanded = cardDetails.classList.toggle('is-expanded')
      toggleButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false')
    })
  })
</script>

