const highlightProjectResultText = (text: string) =>
  text.replace(
    /(打通低成本数据生产与量产级 POC 验证闭环|领域首次、领域领先水平|显著优于同行（客户反馈）|有效降低手势疲劳感并提升稳定性|体验优于市面方案并获得客户高度认可|首次打通“人–车–环境”联合交互能力|SOTA|首次|第一|首发|领先|0-1|量产级|5%\+|95%\+|96%|>96%|20\+|15 名|43 人|10\+|6 人|1 个月)/g,
    '<strong class="result-highlight">$1</strong>'
  )

const isProjectSectionPrimary = (label: string) =>
  label === 'S + T' || label === 'A' || label === 'Other'

const mergeProjectSections = (
  sections: { label: string; text: ProjectSectionContent }[]
) => {
  return sections.reduce<{ label: string; texts: ProjectSectionContent[] }[]>((groups, section) => {
    const lastGroup = groups[groups.length - 1]

    if (lastGroup && lastGroup.label === section.label) {
      lastGroup.texts.push(section.text)
      return groups
    }

    groups.push({
      label: section.label,
      texts: [section.text]
    })

    return groups
  }, [])
}

