                    <div class='sm:pt-0.5'>
                      <span
                        class:list={[
                          'inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.08em]',
                          getProjectSectionBadgeClass(section.label)
                        ]}
                      >
                        {section.label}
                      </span>
                    </div>
                    <div class='space-y-1.5'>
                      {section.texts.map((text) => (
                        <div class='flex items-start gap-2'>
                          {section.texts.length > 1 ? (
                            <span
                              class:list={[
                                'mt-[0.55rem] size-1 shrink-0 rounded-full bg-current opacity-35',
                                section.label === 'R' && 'opacity-50'
                              ]}
