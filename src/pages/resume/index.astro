const skills = [
  { label: '算法方向', items: ['行为识别', '手势识别', '3D 人手重建', '目标检测', '多模态大模型'] },
  { label: '深度学习', items: ['PyTorch', 'YOLO', 'InternVL', 'LLaMA', 'SAM', 'DINO'] },
  { label: '工程部署', items: ['模型量化 (w8A8 / INT8)', '地平线 J 系列芯片', 'ONNX'] },
  { label: '工具 & 工程', items: ['Python', 'C++', 'Git', 'DAG 自动化流程', '数据 Pipeline'] },
